# ============================================================
# G-Floor Custom Chat Environment Variable Template
# ============================================================
#
# This file documents required environment variables only.
# Never place real passwords, access tokens, database URLs,
# Microsoft secrets, or SMTP credentials in this file.
#
# Real values belong in:
#
# - Local development: .env
# - Production: Render Environment Variables
#
# ============================================================


# ------------------------------------------------------------
# Shopify / Browser Access
# ------------------------------------------------------------

SHOPIFY_ALLOWED_ORIGIN=https://gfloor.com


# ------------------------------------------------------------
# Customer Service Routing
# ------------------------------------------------------------

CUSTOMER_SERVICE_EMAIL=CustomerService@GProductsLLC.com


# ------------------------------------------------------------
# Email Delivery Mode
# ------------------------------------------------------------
#
# Allowed values:
#
# auto
# graph
# smtp
#
# Keep this set to auto until Microsoft Graph has been tested.
#

EMAIL_DELIVERY_MODE=auto


# ------------------------------------------------------------
# Microsoft Graph
# ------------------------------------------------------------
#
# Leave these blank in .env.example.
# NetStandard will provide the real values.
#

MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

GRAPH_SENDER_EMAIL=CustomerService@GProductsLLC.com


# ------------------------------------------------------------
# SMTP Fallback
# ------------------------------------------------------------

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=
SMTP_PASS=

SMTP_FROM=G-Floor Chat <CustomerService@GProductsLLC.com>


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

DATABASE_URL=


# ------------------------------------------------------------
# Protected Administrative Dashboards
# ------------------------------------------------------------

ADMIN_TOKEN=


# ------------------------------------------------------------
# Live Customer Service Availability
# ------------------------------------------------------------

LIVE_AGENT_QUEUE_STATUS=normal
LIVE_AGENT_NORMAL_WAIT=2-5
LIVE_AGENT_BUSY_WAIT=5-10


# ------------------------------------------------------------
# Application Runtime
# ------------------------------------------------------------

NODE_ENV=production
PORT=3000